# ========================
# PostgreSQL configuration
# ========================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mydb
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mydb
#DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require  # producción

# =====================
# JWT configuration
# =====================
JWT_SECRET=changeme123456789012345678901234567890  # mínimo 32 caracteres en producción
JWT_EXPIRES_IN=1h
#JWT_EXPIRES_IN=15m  # ejemplo seguro para producción

# =====================
# Redis configuration
# =====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS=false
#REDIS_TLS=true  # producción

# =====================
# Application settings
# =====================
NODE_ENV=development
PORT=3000

# =====================
# Security
# =====================
CSP_ENABLED=true
HSTS_MAX_AGE=63072000  # 2 años recomendado en producción
API_VERSION=1.0.0

# =====================
# CORS
# =====================
CORS_ALLOWED_ORIGINS=http://localhost:3000
#CORS_ALLOWED_ORIGINS=https://tudominio.com,https://app.tudominio.com  # producción
