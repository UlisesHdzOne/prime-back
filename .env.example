# PostgreSQL configuration
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
DATABASE_URL=
#DATABASE_URL=postgresql://user:pass@host:5432/db?sslmode=require  solo en produccion
# JWT configuration
JWT_SECRET=
JWT_EXPIRES_IN=

# Redis configuration
REDIS_HOST=
REDIS_PORT=
