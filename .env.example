#REDIS_TLS=true  solo en ptoduccion 

# Application settings
NODE_ENV=
PORT=

# Security
CSP_ENABLED=true
HSTS_MAX_AGE=63072000
API_VERSION=1.0.0

# ejemplo para produccion
CORS_ALLOWED_ORIGINS=https://tudominio.com,https://app.tudominio.com
